{
  "name": "setwise",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Harmonic mixing intelligence for DJs, built to show off real SQL.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node --experimental-strip-types scripts/migrate.ts",
    "db:seed": "node --experimental-strip-types scripts/seed.ts",
    "db:seed:generate": "node --experimental-strip-types scripts/generate-seed.ts",
    "db:queries:generate": "node --experimental-strip-types scripts/generate-query-constants.ts",
    "db:reset": "node --experimental-strip-types scripts/reset.ts",
    "test": "node --experimental-strip-types --test tests/*.test.ts"
  },
  "dependencies": {
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "pg": "8.16.3",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.15.19",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.1",
    "@types/pg": "8.15.6",
    "typescript": "5.9.3",
    "tailwindcss": "4.1.14",
    "@tailwindcss/postcss": "4.1.14",
    "eslint": "9.38.0",
    "eslint-config-next": "16.3.5"
  }
}
